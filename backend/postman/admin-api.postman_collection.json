		{
			"name": "Manga CRUD",
			"description": "Полный цикл create → get → update → delete(с телом удалённой записи) → get(404). Запускать через Collection Runner по порядку: create сохраняет {{mangaId}}, update проверяет частичность PATCH.",
			
			"item": [
				{
					"name": "list",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('код 200', () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test('manga — массив', () => pm.expect(body.manga).to.be.an('array'));",
									"pm.test('не больше limit', () => {",
									"    pm.expect(body.manga.length).to.be.at.most(2);",
									"});",
									"pm.test('total — число, не меньше размера страницы', () => {",
									"    pm.expect(Number(body.total)).to.be.at.least(body.manga.length);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin-api/manga?limit=2&offset=0",
							"host": ["{{baseUrl}}"],
							"path": ["admin-api", "manga"],
							"query": [
								{ "key": "source_id", "value": "", "disabled": true },
								{ "key": "query", "value": "", "disabled": true },
								{ "key": "status", "value": "ongoing", "disabled": true, "description": "ongoing | completed | hiatus | cancelled | discontinued" },
								{ "key": "limit", "value": "2" },
								{ "key": "offset", "value": "0" }
							]
						},
						"description": "Постраничный список. limit по умолчанию 50, максимум 200."
					}
				},
				{
					"name": "create",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('код 201', () => pm.response.to.have.status(201));",
									"",
									"const body = pm.response.json();",
									"pm.test('id присвоен', () => pm.expect(Number(body.id)).to.be.above(0));",
									"pm.test('publication_status из запроса', () => {",
									"    pm.expect(body.publication_status).to.eql('ongoing');",
									"});",
									"pm.test('source_name подставлен из БД', () => {",
									"    pm.expect(body.source_name).to.have.length.above(0);",
									"});",
									"",
									"pm.collectionVariables.set('mangaId', String(body.id));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"source_id\": {{sourceId}},\n    \"url\": \"postman_test_{{$timestamp}}\",\n    \"title\": \"Тестовая манга (Postman)\",\n    \"alt_titles\": \"Postman Test Manga\",\n    \"latest_chapter\": \"1\",\n    \"chapters_count\": 1,\n    \"publication_status\": \"ongoing\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin-api/manga",
							"host": ["{{baseUrl}}"],
							"path": ["admin-api", "manga"]
						},
						"description": "Обязательны source_id (существующий источник), url и title."
					}
				},
				{
					"name": "get",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('код 200', () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test('id совпадает', () => {",
									"    pm.expect(Number(body.id)).to.eql(Number(pm.collectionVariables.get('mangaId')));",
									"});",
									"pm.test('title из create', () => {",
									"    pm.expect(body.title).to.eql('Тестовая манга (Postman)');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin-api/manga/{{mangaId}}",
							"host": ["{{baseUrl}}"],
							"path": ["admin-api", "manga", "{{mangaId}}"]
						}
					}
				},
				{
					"name": "update",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('код 200', () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test('title обновлён', () => {",
									"    pm.expect(body.title).to.eql('Тестовая манга (обновлено)');",
									"});",
									"pm.test('alt_titles НЕ затёрт — PATCH частичный', () => {",
									"    pm.expect(body.alt_titles).to.eql('Postman Test Manga');",
									"});",
									"pm.test('latest_chapter НЕ затёрт', () => {",
									"    pm.expect(body.latest_chapter).to.eql('1');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Тестовая манга (обновлено)\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin-api/manga/{{mangaId}}",
							"host": ["{{baseUrl}}"],
							"path": ["admin-api", "manga", "{{mangaId}}"]
						},
						"description": "Передаются только редактируемые поля. source_id и url не меняются принципиально."
					}
				},
				{
					"name": "delete",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('код 200 (тело с удалённой записью)', () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test('id совпадает', () => {",
									"    pm.expect(Number(body.id)).to.eql(Number(pm.collectionVariables.get('mangaId')));",
									"});",
									"pm.test('title — последнее состояние записи', () => {",
									"    pm.expect(body.title).to.eql('Тестовая манга (обновлено)');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin-api/manga/{{mangaId}}",
							"host": ["{{baseUrl}}"],
							"path": ["admin-api", "manga", "{{mangaId}}"]
						},
						"description": "Возвращает удалённую запись (последнее состояние перед удалением)."
					}
				},
				{
					"name": "get после delete (404)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('код 404 — запись удалена', () => pm.response.to.have.status(404));",
									"pm.test('error описан', () => {",
									"    const body = pm.response.json();",
									"    pm.expect(body.error).to.have.length.above(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin-api/manga/{{mangaId}}",
							"host": ["{{baseUrl}}"],
							"path": ["admin-api", "manga", "{{mangaId}}"]
						}
					}
				}
			]
		},
		{
			"name": "Errors (негативные)",
			"description": "Проверка кодов ошибок. Запускать после Auth (нужны cookie от login), порядок не критичен.",
