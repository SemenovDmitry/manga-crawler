{
	"info": {
		"name": "Manga Crawler Admin API",
		"description": "Коллекция для ручного тестирования Admin API (base: {{baseUrl}}/admin-api).\n\nПодготовка:\n1. Заполните переменные username и password (значки коллекции → Variables, или правьте у себя).\n2. Запускайте папку Auth целиком сверху вниз — login сохранит токены в переменные коллекции, остальные запросы подставят их сами.\n3. Папка Manga CRUD использует {{$timestamp}} в url для уникальности и сохраняет {{mangaId}} из ответа create — запускайте её через Collection Runner (порядок важен).\n\nВсе запросы содержат тесты (вкладка Tests) — прогон виден в Test Results каждого ответа и в Collection Runner.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8081" },
		{ "key": "username", "value": "admin" },
		{ "key": "password", "value": "change-me" },
		{ "key": "sourceId", "value": "1" },
		{ "key": "chatId", "value": "100" },
		{ "key": "mangaId", "value": "" }
	],
	"item": [
		{
			"name": "Auth",
			"description": "Получение и обновление токенов через HttpOnly-cookie: login ставит admin_access/admin_refresh, Postman кладёт их в cookie-jar и дальше отправляет автоматически.",
			"item": [
				{
					"name": "login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('код 200', () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"",
									
									"pm.test('expires_in — положительное число', () => {",
									"    pm.expect(body.expires_in).to.be.above(0);",
									"});",
									"",
									"// Токены приходят только в HttpOnly-cookie — проверяем Set-Cookie.",
									"const sc = pm.response.headers.filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value).join(';');",
									"pm.test('ставится admin_access (HttpOnly)', () => {",
									"    pm.expect(sc).to.include('admin_access=');",
									"    pm.expect(sc).to.include('HttpOnly');",
									"});",
									"pm.test('ставится admin_refresh (HttpOnly)', () => {",
									"    pm.expect(sc).to.include('admin_refresh=');",
									"    pm.expect(sc).to.include('HttpOnly');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin-api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["admin-api", "auth", "login"]
						},
						"description": "Вход по логину/паролю из env сервера. Токены ставятся в HttpOnly-cookie admin_access/admin_refresh (Postman сохранит их в cookie-jar). Refresh одноразовый: каждый refresh выдаёт новую пару, старый гасится."
					}
				},
				{
					"name": "refresh",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('код 200', () => pm.response.to.have.status(200));",
									"",
									"pm.test('ротация: приходит новая пара cookie', () => {",
									"    const sc = pm.response.headers.filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value).join(';');",
									"    pm.expect(sc).to.include('admin_access=');",
									"    pm.expect(sc).to.include('admin_refresh=');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin-api/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["admin-api", "auth", "refresh"]
						},
						"description": "Ротация пары токенов. Старый refresh гасится; повторное использование — 401 (считается признаком кражи)."
					}
				},
				{
					"name": "logout",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('код 204 (без тела)', () => pm.response.to.have.status(204));",
									"pm.test('тело пустое', () => pm.expect(pm.response.text()).to.eql(''));",
									"pm.test('обе cookie погашены', () => {",
									"    const sc = pm.response.headers.filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value).join(';');",
									"    pm.expect(sc).to.include('admin_access=');",
									"    pm.expect(sc).to.include('admin_refresh=');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin-api/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["admin-api", "auth", "logout"]
						},
						"description": "Отзывает refresh-сессию и гасит обе auth-cookie. После logout refresh с погашенной cookie вернёт 401."
					}
				}
			]
		},
		{
			"name": "Sources",
			
			"item": [
				{
					"name": "list",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('код 200', () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test('sources — массив', () => pm.expect(body.sources).to.be.an('array'));",
									"",
									"if (body.sources.length > 0) {",
									"    const s = body.sources[0];",
									"    pm.test('элемент содержит id, name, engine, enabled', () => {",
									"        pm.expect(s).to.have.all.keys('id', 'name', 'base_url', 'engine', 'enabled', 'full_crawled_at', 'full_crawl_interval_secs', 'next_full_crawl_at');",
									"    });",
									"    // Первый источник — в переменную для setEnabled/recrawl.",
									"    pm.collectionVariables.set('sourceId', String(s.id));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin-api/sources",
							"host": ["{{baseUrl}}"],
							"path": ["admin-api", "sources"]
						},
						"description": "Все источники, включая выключенные. Опционально ?enabled=true|false."
					}
				},
				{
					"name": "setEnabled",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('код 200', () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test('enabled в ответе соответствует запросу', () => {",
									"    pm.expect(body.enabled).to.eql(true);",
									"});",
									"pm.test('id совпадает', () => {",
									"    pm.expect(Number(body.id)).to.eql(Number(pm.collectionVariables.get('sourceId')));",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"enabled\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin-api/sources/{{sourceId}}/enabled",
							"host": ["{{baseUrl}}"],
							"path": ["admin-api", "sources", "{{sourceId}}", "enabled"]
						},
						"description": "Включение/выключение источника. Подхватывается краулером на следующем проходе."
					}
				},
				{
					"name": "recrawl",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('код 200', () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test('next_full_crawl_at сброшен (null)', () => {",
									"    pm.expect(body.next_full_crawl_at).to.eql(null);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin-api/sources/{{sourceId}}/recrawl",
							"host": ["{{baseUrl}}"],
							"path": ["admin-api", "sources", "{{sourceId}}", "recrawl"]
						},
						"description": "Сброс next_full_crawl_at — полный обход источника при следующем проходе краулера."
					}
				}
			]
		},
