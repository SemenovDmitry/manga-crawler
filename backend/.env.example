# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=mangauser
DB_PASSWORD=mangapass
DB_NAME=mangadb

# Crawler
CRAWL_INTERVAL=30m
CRAWL_REQUEST_DELAY=1s
CRAWL_MANGA_REFRESH_LIMIT=200
# CRAWL_FORCE_FULL=true  — принудительный полный обход всех источников при старте
# CRAWL_SKIP_FULL=true   — не начинать полный обход, даже когда подошло расписание
# CRAWL_ONCE=true        — выполнить один проход и выйти (режим для cron)

# Admin API
ADMIN_LISTEN_ADDR=:8081
ADMIN_USERNAME=admin
# bcrypt-хэш пароля: go run ./cmd/hashpassword
ADMIN_PASSWORD_HASH=
# секрет подписи JWT: openssl rand -hex 32
JWT_SECRET=
# ADMIN_TOKEN_TTL=15m     — срок жизни access-токена (cookie admin_access)
# ADMIN_REFRESH_TTL=168h  — срок жизни refresh-токена (7 дней, cookie admin_refresh)
# ADMIN_COOKIE_SECURE=true — флаг Secure у auth-cookie, включать только за TLS
