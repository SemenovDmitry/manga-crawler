# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=mangauser
DB_PASSWORD=mangapass
DB_NAME=mangadb

# Crawler
CRAWL_INTERVAL=30m
CRAWL_REQUEST_DELAY=1s
CRAWL_MANGA_REFRESH_LIMIT=200
# Сколько первых страниц каталога /list (по 50 карточек, отсортированных
# по дате создания) дополнительно проверять в каждом инкрементальном проходе.
# Нужно источникам с лимитом sitemap (a.zazaza.me кладёт в sitemap не больше
# 10000 URL): новые карточки попадают в sitemap не сразу. 0 — не проверять.
# Полный обход всегда идёт и по sitemap, и по каталогу целиком; карточки,
# найденные через sitemap, через каталог повторно не парсятся.
CRAWL_CATALOG_PAGES=2
# Расписание полных обходов хранится в БД по каждому источнику:
#   sources.next_full_crawl_at       — когда следующий полный обход
#   sources.full_crawl_interval_secs — персональный интервал (1209600 = 2 недели)
# Новый источник (INSERT в sources) обходится полностью при первом старте,
# дальше — по собственному расписанию.
# CRAWL_FORCE_FULL=true  — принудительный полный обход всех источников при старте
# CRAWL_SKIP_FULL=true   — не начинать полный обход, даже когда подошло расписание
# CRAWL_ONCE=true        — выполнить один проход и выйти (режим для cron)
